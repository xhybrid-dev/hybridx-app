rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Fields the client is never allowed to change via update.
    // These must only be set via Admin SDK (server-side).
    // NOTE: trialStartDate / trialEndDate are included — the trial window is
    // derived from trialStartDate, so allowing client updates would let a user
    // extend their own trial indefinitely.
    // NOTE: marketingConsent and its timestamps are included. The athlete does
    // control this setting, but it must be changed through
    // /api/marketing/preferences so the mirrored `marketingSubscribers` record
    // is updated in the same operation. A direct client write would leave the
    // two collections disagreeing about who may be emailed — and the subscriber
    // record is the one the send path actually reads.
    // NOTE: completedWorkouts and lastWorkoutAt are included. They are derived
    // counters maintained server-side by the marketing activity reconciler,
    // which reads the workoutSessions stream. Segments, engagement tags and two
    // derived triggers read completedWorkouts to decide who gets emailed, so a
    // client that could set it could place itself into any engagement segment.
    function isWritingProtectedUserField() {
      let protected = ['isAdmin', 'subscriptionStatus', 'subscriptionTier',
                       'stripeCustomerId', 'stripeSubscriptionId', 'subscriptionId',
                       'trialEndsAt', 'trialEndDate', 'trialStartDate',
                       'marketingConsent', 'marketingConsentAt', 'marketingUnsubscribedAt',
                       'completedWorkouts', 'lastWorkoutAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protected);
    }

    // On create the client stamps trialStartDate (at signup) but must not
    // self-grant admin or a paid/active subscription. trialStartDate is pinned
    // to server time (±10m) so the trial cannot be future-dated.
    function isValidUserCreate() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false)
          && (!('subscriptionStatus' in data) || data.subscriptionStatus == 'trial')
          && (!('subscriptionTier' in data))
          && (!('stripeCustomerId' in data) || data.stripeCustomerId == null)
          && (!('subscriptionId' in data) || data.subscriptionId == null)
          && (!('trialEndsAt' in data))
          && (!('trialEndDate' in data))
          && (!('trialStartDate' in data) || (
               data.trialStartDate >= request.time - duration.value(10, 'm')
               && data.trialStartDate <= request.time + duration.value(10, 'm')
             ));
    }

    match /users/{userId} {
      // Users can only read and update their own document,
      // and must not touch protected server-managed fields.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !isWritingProtectedUserField();

      // On create, the document path must match the authenticated user's UID,
      // and the client may not self-grant admin/subscription privileges.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUserCreate();

      // Allow access to subcollections like personalPrograms
      match /personalPrograms/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public programs — readable by every signed-in athlete, as before.
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // User-specific programs. Kept in their own collection so the public
    // /programs listing above stays an unrestricted query: Firestore fails an
    // entire list query when any document it returns is off-limits, so mixing
    // restricted programs into /programs would break every athlete's program
    // list. See src/lib/program-visibility.ts.
    //
    // Readable by the athletes it is assigned to, by athletes grandfathered in
    // because it is still their active plan (retainedUserIds), and by admins.
    // Athletes list these with a where('assignedUserIds','array-contains',uid)
    // query, so every document such a query returns already satisfies the rule.
    // Conditions are ordered cheapest-first — isAdmin() costs a document read,
    // the array checks only inspect the program being returned.
    match /customPrograms/{programId} {
      allow read: if request.auth != null && (
                     request.auth.uid in resource.data.get('assignedUserIds', [])
                     || request.auth.uid in resource.data.get('retainedUserIds', [])
                     || isAdmin()
                  );
      allow write: if request.auth != null && isAdmin();
    }

    match /workoutSessions/{sessionId} {
      // For read operations, check userId on the existing document
      allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Both sides are checked, like journalEntries below.
      //
      // `request.resource.data` on an update is the POST-write document, so
      // testing it alone said only "the doc is mine afterwards" — a caller who
      // updated someone else's session and set userId to their own uid in the
      // same write passed, and took the document over. `resource.data` is the
      // pre-write state, so requiring both means: it was already mine, and it
      // stays mine.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // `request.resource` does not exist on a delete, so the previous combined
      // rule referenced a null field and denied every delete. Check the existing
      // document instead.
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Client may create notifications addressed to itself
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Client may mark its own notifications as read (update only the `read` field)
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /journalEntries/{entryId} {
      allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // What the coach remembers about an athlete between conversations — that
    // they're away next week, that the knee is still sore. Written only by the
    // server (Admin SDK) from what the athlete actually said; the client reads
    // its own notes so the app can show them back and never writes, because a
    // note the client could forge is a note the coach would then act on.
    match /coachNotes/{noteId} {
      allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Edge Coach conversations. Every read and write goes through
    // /api/ai/coach-chat with the Admin SDK (which bypasses these rules), so
    // the client is given read access to its own threads only as a safety net
    // and is never allowed to write: a thread the athlete could edit would let
    // them put words in the coach's mouth and feed them back as history.
    match /coachConversations/{conversationId} {
      allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // The event document src/lib/analytics.ts writes, and nothing else. Rules
    // cannot rate-limit, so for the unauthenticated clause the shape IS the
    // limit: without it, any script could write unlimited documents of
    // near-arbitrary size to this collection (a billing-abuse vector) and
    // poison the admin analytics dashboard that reads it.
    function isWellFormedAnalyticsEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'event', 'properties', 'platform', 'sessionId', 'timestamp'])
          && d.event is string && d.event.size() <= 64
          && d.platform is string && d.platform.size() <= 16
          && d.sessionId is string && d.sessionId.size() <= 64
          && d.properties is map && d.properties.size() <= 20;
    }

    match /analyticsEvents/{eventId} {
      // Authenticated users can write events tagged with their own UID
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isWellFormedAnalyticsEvent();

      // Unauthenticated visitors, only for the two events that genuinely fire
      // before an account exists — both from the signup flow in
      // src/components/auth-forms.tsx. Everything else needs a signed-in uid.
      allow create: if request.resource.data.userId == 'anonymous'
                    && request.resource.data.event in ['signup_page_viewed', 'onboarding_step_completed']
                    && isWellFormedAnalyticsEvent();

      // No client reads, updates, or deletes — admin SDK only
    }

    // ===================================================================
    // Marketing
    // ===================================================================
    // Every marketing collection is admin-read, never client-write. All writes
    // go through the Admin SDK, which bypasses these rules entirely — so the
    // write deny below is not an inconvenience to the app, it is the guarantee
    // that nothing but server code can touch a subscriber list, a consent
    // record, or a queued send.
    //
    // The admin UI reads these collections directly from the client for live
    // tables, which is why read is allowed for admins rather than being denied
    // outright.
    //
    // Note `isAdmin()` costs a document read per evaluation. That is acceptable
    // here: these collections are only ever queried by the handful of admins
    // using the marketing console, never by athletes on the hot path.

    match /marketingSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketingCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;

      // Per-recipient send rows and per-URL click counters.
      match /sends/{sendId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /linkClicks/{urlHash} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /marketingJourneys/{journeyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketingJourneyRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketingSegments/{segmentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Intake routes. Written by the Admin SDK only — including the
    // auto-registration that happens when a new funnel sends its first lead,
    // which arrives over the server-to-server lead bridge and never from a
    // browser. A client that could write here could invent an origin for
    // itself and land in whatever segment it liked.
    match /marketingRoutes/{routeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketingPlans/{planId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketingSettings/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The trigger bus. Written only by server code; not readable from the
    // client at all, since event payloads can carry athlete detail that has no
    // reason to reach a browser.
    match /marketingEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
