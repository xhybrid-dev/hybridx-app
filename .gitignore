# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored, so nested installs are covered too: functions/node_modules was
# tracked (20,987 files, 240MB) because the leading slash pinned this to the repo
# root, which slowed every clone, status and search — and hid that directory's
# dependencies from the tooling that scans package.json.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# secrets / signing material — never commit
*.jks
*.keystore
*.p8
*.p12
PLAY_STORE_TEST_CREDENTIALS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# next-pwa build output. Regenerated into public/ by every build (and by App
# Hosting on deploy), so a tracked copy only ever dirties the working tree.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js

# Capacitor
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/.idea/
/android/captures/
/android/app/release/
/ios/App/build/
/ios/App/Pods/
/ios/App/.xcode.env.local